[Unit]
Description=AIS Tracker Boat Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rostape1
WorkingDirectory=/home/rostape1/AIS-Tracker
ExecStart=/bin/bash /home/rostape1/AIS-Tracker/pi/startup.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
