# OS files
.DS_Store

# Map tiles (large offline cache)
static/tiles/

# Database files
*.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.pyc

# Secrets
.env

# TLS certificates (generated on Pi)
certs/

# Cached data
static/data/

# Pi deploy bundle (regenerated by build_static_bundle.sh)
static.tgz

# Claude Code — ignore local state, but DO track .claude/skills/ so repo policy
# (e.g. the /pre-ship-review gate that CLAUDE.md links to) travels with the repo.
.claude/*
!.claude/skills/
.claude/settings.local.json
.gstack/

# Local dev junk that should never be committed (was accidentally swept in by `git add -A`)
logs/
logs.zip
# NMEA capture logs only — an unanchored `*.txt` silently swallowed every
# requirements.txt (and any new .txt fixture) on `git add`.
logs/*.txt
nmea_*.txt
!**/requirements.txt
vendor/
boat_test.sh
build_static_bundle.sh
debug_pi.sh
nmea_loggerOLD.py
wind_radar.html

# Route test harness disk cache
tests/.cache/

# Pi reverse-proxy disk cache — created by running boat_server.py locally.
# Leading slash anchors it to the repo root: an unanchored `cache/` would also
# swallow any nested directory of that name (P23).
/cache/

# tools/build_polar.py scratch output (charts that matter are copied to docs/polar/)
tools/polar_out/
